    <worksheet name='New Guest'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#550000' fontname='Times New Roman' fontsize='18'>New Guest</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (hotel_booking_final)' name='federated.1m8f3m612l10m31ctnk851wsdk5s' />
          </datasources>
          <datasource-dependencies datasource='federated.1m8f3m612l10m31ctnk851wsdk5s'>
            <column caption='Guest Type' datatype='string' name='[Calculation_2995668349882368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_repeated_guest]= 1 THEN &quot;Repeat Guest&quot; ELSE &quot;New Guest&quot; END' />
            </column>
            <column caption='New Guest' datatype='integer' name='[Calculation_5771111349579776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Calculation_2995668349882368] = &quot;New Guest&quot;&#13;&#10;THEN [customer_id]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Customer Id' datatype='integer' name='[customer_id]' role='dimension' type='ordinal' />
            <column caption='Customer Type' datatype='string' name='[customer_type]' role='dimension' type='nominal' />
            <column caption='Is Repeated Guest' datatype='integer' name='[is_repeated_guest]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5771111349579776]' derivation='User' name='[usr:Calculation_5771111349579776:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1m8f3m612l10m31ctnk851wsdk5s].[Action (Customer Type)]'>
            <groupfilter function='level-members' level='[customer_type]' user:ui-action-filter='[Action10_6D4AFCA249FB43FC9A9B6E5A7ACDDF45]' user:ui-enumeration='all' user:ui-marker='enumerate' />
