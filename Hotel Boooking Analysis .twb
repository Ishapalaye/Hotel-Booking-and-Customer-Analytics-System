      <aliases enabled='yes' />
      <column caption='cancellation rate' datatype='real' default-format='p0.00%' name='[Calculation_0230945961562112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_canceled])&#13;&#10;/&#13;&#10;COUNT([booking_id])' />
      </column>
      <column caption='Guest Type' datatype='string' name='[Calculation_2995668349882368]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_repeated_guest]= 1 THEN &quot;Repeat Guest&quot; ELSE &quot;New Guest&quot; END' />
      </column>
      <column caption='Donut' datatype='integer' name='[Calculation_3089676992122880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Recommended Discount' datatype='real' default-format='p0%' name='[Calculation_5254890926489601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_repeated_guest] = 1 THEN&#13;&#10;0.20&#13;&#10;ELSE&#13;&#10;0.10&#13;&#10;END' />
