    <worksheet name='Cancellation Rate By Hotel'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1e4a32' fontname='Times New Roman' fontsize='16'>Cancellation Rate By Hotel</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (hotel_booking_final)' name='federated.1m8f3m612l10m31ctnk851wsdk5s' />
          </datasources>
          <datasource-dependencies datasource='federated.1m8f3m612l10m31ctnk851wsdk5s'>
            <column caption='cancellation rate' datatype='real' default-format='p0.00%' name='[Calculation_0230945961562112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_canceled])&#13;&#10;/&#13;&#10;COUNT([booking_id])' />
            </column>
            <column caption='Booking Id' datatype='integer' name='[booking_id]' role='dimension' type='ordinal' />
            <column caption='Hotel' datatype='string' name='[hotel]' role='dimension' type='nominal' />
            <column caption='Is Canceled' datatype='integer' name='[is_canceled]' role='measure' type='quantitative' />
            <column caption='Market Segment' datatype='string' name='[market_segment]' role='dimension' type='nominal' />
            <column-instance column='[hotel]' derivation='None' name='[none:hotel:nk]' pivot='key' type='nominal' />
