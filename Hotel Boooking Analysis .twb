          <format attr='font-size' value='14' />
          <format attr='color' value='#000000' />
          <format attr='font-weight' value='normal' />
        </style-rule>
        <style-rule element='story-title'>
          <format attr='font-family' value='Times New Roman' />
        </style-rule>
      </style>
